# ============================================================
# 이유 (이유.com) — 프로덕션 환경변수 템플릿
# ============================================================
# 이 파일은 예시 파일입니다. 절대 커밋하지 마세요 (.gitignore 확인).
# Render Dashboard → iyu-web → Environment 탭에 아래 항목을 직접 입력하세요.
# render.yaml 의 sync: true 항목은 자동 주입되므로 수동 입력 불필요.
# ============================================================

# ── 데이터베이스 ──────────────────────────────────────────────
# Render 자동주입(fromDatabase) 또는 Supabase External Connection URL
DATABASE_URL=postgresql://유저:비밀번호@호스트:5432/DB이름

# ── 서버 기본 ─────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ── 세션 보안 ─────────────────────────────────────────────────
# Render가 generateValue로 자동 생성. 로컬에서 생성: openssl rand -base64 48
SESSION_SECRET=최소32자이상랜덤문자열

# ── 전화번호 HMAC 페퍼 ────────────────────────────────────────
# ⚠️ 한 번 설정 후 절대 변경 금지 (기존 전화번호 해시 전부 무효화)
# 생성: openssl rand -hex 32
PHONE_PEPPER=랜덤64자hex문자열

# ── CORS / 도메인 ─────────────────────────────────────────────
# IDN 양쪽 폼 + 앱 WebView 오리진을 모두 포함
ALLOWED_ORIGIN=https://이유.com,https://www.이유.com,https://xn--2r5b1f.com,https://www.xn--2r5b1f.com,capacitor://localhost

# ── 관리자 ────────────────────────────────────────────────────
# ⚠️ fail-closed: 비어있으면 /api/admin/*, /api/sync/* 전부 차단됨
# DB에서 SELECT id FROM users WHERE username='...'; 로 확인
ADMIN_USER_IDS=uuid1,uuid2

# ── 선거 블랙아웃 ─────────────────────────────────────────────
# 공직선거법 §108 — 선거일 전날 오전 0시 ~ 선거일 오후 6시 여론조사 결과 공표 금지
ELECTION_DAY=2026-06-03

# ── AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
# OPENAI_API_KEY=  # 선택 (미설정 시 Groq로 폴백)

# ── 공공데이터 ─────────────────────────────────────────────────
OPEN_ASSEMBLY_API_KEY=your_open_assembly_api_key
DATA_GO_KR_API_KEY=your_data_go_kr_api_key

# ── 카카오 OAuth ──────────────────────────────────────────────
# Kakao Developers → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=your_kakao_rest_api_key
# Redirect URI: 아래 주소를 Kakao Developers → 카카오 로그인 → Redirect URI 에 추가
KAKAO_REDIRECT_URI=https://xn--2r5b1f.com/api/auth/kakao/callback
# KAKAO_CLIENT_SECRET=  # 보안 메뉴에서 활성화한 경우만

# ── 구글 OAuth ────────────────────────────────────────────────
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Redirect URI: 아래 주소를 Google Cloud Console 승인된 리디렉션 URI에 추가
GOOGLE_REDIRECT_URI=https://xn--2r5b1f.com/api/auth/google/callback

# ── Apple OAuth (Sign in with Apple) — App Store 심사 4.8 필수 ──
# Apple Developer → Certificates, IDs & Profiles → Services IDs
APPLE_TEAM_ID=10자리팀ID
APPLE_KEY_ID=10자리키ID
APPLE_SERVICE_ID=com.antigravity.iyu.service
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
여기에.p8파일내용을줄바꿈포함하여붙여넣기
-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=https://xn--2r5b1f.com/api/auth/apple/callback

# ── 구글 애널리틱스 (GA4) ─────────────────────────────────────
VITE_GA_ID=G-XXXXXXXXXX

# ── SMS / 본인확인 (선택) ─────────────────────────────────────
# 미설정 시 /api/auth/send-sms 가 503 반환 (PASS/NICE/KMC 어댑터 연동 후 설정)
# SMS_PROVIDER=nhncloud
# SMS_API_KEY=
# SMS_API_SECRET=

# ── Sentry 에러 모니터링 (선택) ───────────────────────────────
# 설정 시 서버 500 에러 자동 수집
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ── 개발용 mock 계정 (반드시 0) ───────────────────────────────
ENABLE_DEV_TESTER=0
