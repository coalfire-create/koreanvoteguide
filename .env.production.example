# 프로덕션 환경변수 - Railway/Vercel/Fly 등 PaaS Variables 탭에 입력
# 로컬 .env 파일은 절대 커밋하지 말 것

DATABASE_URL=postgresql://유저:비밀번호@호스트:5432/DB이름
GEMINI_API_KEY=your_gemini_api_key_here
OPEN_ASSEMBLY_API_KEY=your_api_key_here
PORT=3000
ALLOWED_ORIGIN=https://your-domain.example.com

# 세션 보안 — 반드시 32자 이상. 생성: `openssl rand -base64 48`
SESSION_SECRET=your_random_secret_at_least_32_chars
NODE_ENV=production

# 관리자 사용자 ID — 쉼표 구분. 비어있으면 모든 /api/admin/*, /api/sync/* 차단됨 (fail-closed)
ADMIN_USER_IDS=

# PII 해싱 페퍼 — 전화번호 lookup용 HMAC. 한 번 정하면 절대 바꾸지 말 것
PHONE_PEPPER=replace_with_random_long_string

# 본인확인 / SMS — 프로덕션에서는 PASS/NICE 등 KISA 지정 본인확인기관 연동 필수
# 자체 SMS 발송은 "본인확인"이 아니며 "실명인증" 표시는 정보통신망법 위반 소지
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=

# 구글 로그인 API
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# 구글 애널리틱스 (GA4) 측정 ID (예: G-XXXXXXXXXX)
VITE_GA_ID=your_ga_measurement_id

# 에러 모니터링 (선택)
SENTRY_DSN=

# 개발용 mock 계정 활성화 — 프로덕션에서는 절대 1로 두지 말 것
ENABLE_DEV_TESTER=0
