{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://antigravity.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://antigravity.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://antigravity.onrender.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "coalfireant@gmail.com",
        "ascAppId": "6772977396",
        "appleTeamId": "3P399WMQ6J"
      }
    }
  }
}
